        {"t":4,"slot":"attack","held":[],"intent":null,"queue":[{"seq":1,"key":"confirm","via":"slot:attack"}],"slots":["attack","back"]},
        {"t":5,"click":{"logical":[80,463],"board":[240,559],"via":"pathfind"},"held":[],"intent":null,"slots":["attack","back"]},
