{
  "name": "@tk-reawakened/runner-web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./live-session": {
      "types": "./dist/live-session.d.ts",
      "default": "./dist/live-session.js"
    },
    "./load-mode": {
      "types": "./dist/load-mode.d.ts",
      "default": "./dist/load-mode.js"
    },
    "./blob-host": {
      "types": "./dist/blob-host.d.ts",
      "default": "./dist/blob-host.js"
    },
    "./package-source": {
      "types": "./dist/package-source.d.ts",
      "default": "./dist/package-source.js"
    },
    "./pointer": {
      "types": "./dist/pointer.d.ts",
      "default": "./dist/pointer.js"
    },
    "./touch-controls": {
      "types": "./dist/touch-controls.d.ts",
      "default": "./dist/touch-controls.js"
    },
    "./host-state": {
      "types": "./dist/host-state.d.ts",
      "default": "./dist/host-state.js"
    },
    "./app": "./app/index.html"
